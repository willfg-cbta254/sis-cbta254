# Plantilla para producción - sis-cbta254 (CBTA 254)
# Copiar a .env en el servidor: cp .env.production.example .env
# Luego: php artisan key:generate --force (si APP_KEY está vacío)

APP_NAME="CBTA 254"
APP_ENV=production
APP_KEY=base64:HMGyIKvJNAPKtv/jPfi1gxhiXYVV7e6L7OiPtAQP9uU=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos - CAMBIAR en producción
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_dgetaycm
DB_USERNAME=cbta_user
DB_PASSWORD="cambia-esta-password"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# Para producción con más carga, considerar: CACHE_STORE=database o redis

# Si usas Redis en producción, descomenta:
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail - CAMBIAR a SMTP real
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.tu-dominio.com
MAIL_PORT=587
MAIL_USERNAME=noreply@tu-dominio.com
MAIL_PASSWORD="cambia-password"
MAIL_FROM_ADDRESS="noreply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

# Opcional: backups S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
